{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    // The two @kv-designsystem entries type the data-color / data-size / data-color-scheme
    // attributes the designsystem reads.
    "types": ["vite/client", "@kv-designsystem/theme/types", "@kv-designsystem/react/html"],
    "allowArbitraryExtensions": true,
    // Required, not a shortcut: Digdir's bundled types reference preact/svelte/solid and
    // fail to check without it.
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    },
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
