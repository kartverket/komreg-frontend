{
	admin off
}

(security-headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://altinncdn.no; font-src https://altinncdn.no; img-src 'self' data: https://cache.kartverket.no; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}

:{$PORT}

import security-headers

handle_errors {
	# Error responses skip the site-level directives, so the headers are imported again.
	import security-headers
	respond "{err.status_code} {err.status_text}"
}

handle /assets/* {
	root * /srv
	@exists file
	header @exists Cache-Control "public, max-age=31536000, immutable"
	file_server
}

handle {
	root * /srv
	try_files {path} /index.html
	header Cache-Control "no-cache, no-store, must-revalidate"
	header Expires "0"
	file_server
}
